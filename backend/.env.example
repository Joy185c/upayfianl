# ==========================================
# UPAY BD (ImpactIQ) - Backend Environment Variables
# ==========================================

# Database Configuration (Default: local SQLite database)
DATABASE_URL=sqlite:///./upay_demo.db

# Security & JWT Token Authentication
SECRET_KEY=upay-hackathon-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment Settings
DEBUG=True
ENVIRONMENT=demo
APP_NAME=Upay ImpactIQ Platform

# AI / LLM API Keys (Optional - for ImpactIQ AI recommendation features)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
